<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PhotoStudio" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#C6F36B</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#101114</item>
        <item name="android:navigationBarColor">#101114</item>
        <item name="android:windowBackground">#101114</item>
    </style>

    <style name="Theme.PhotoStudio.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#101114</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/photostudio_splash</item>
        <item name="windowSplashScreenIconBackgroundColor">#101114</item>
        <item name="postSplashScreenTheme">@style/Theme.PhotoStudio</item>
    </style>
</resources>